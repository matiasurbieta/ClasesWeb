  "info": {
    "title": "Todos API",
    "description": "CRUD API for the Todo entity, persisted in MongoDB",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTodoDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "deadline": {
            "type": "string",
            "description": "ISO date",
            "example": "2026-12-31"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      },
      "Todo": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "deadline": {
            "format": "date-time",
            "type": "string"
          },
          "done": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "description": "Auth0 user id (`sub` claim). Set by the server from the token, not by the client."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "_id",
          "name",
          "priority",
          "done",
          "owner",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateTodoDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "description": "ISO date",
            "example": "2026-12-31"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    }
