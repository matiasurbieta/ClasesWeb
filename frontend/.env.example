# Copy to .env.local (gitignored). Values from the Auth0 dashboard, see ../AUTH0.md.
AUTH_SECRET=                      # npx auth secret
AUTH_AUTH0_ID=                    # Application > Client ID
AUTH_AUTH0_SECRET=                # Application > Client Secret
AUTH_AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com
AUTH0_AUDIENCE=http://localhost:3001   # API > Identifier, must match the backend's AUTH0_AUDIENCE
NEXT_PUBLIC_API_URL=http://localhost:3001
